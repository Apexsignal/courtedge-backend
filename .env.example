# CourtEdge — proměnné prostředí (lokální vývoj)
# Appka NIKDY neukládá skutečné hodnoty do repozitáře. Zkopíruj tenhle
# soubor na `.env` a vyplň, nebo nastav proměnné přímo v Render dashboardu
# (viz render.yaml). Sekce "Kde získat" viz README.md.

# --- Databáze ---
DATABASE_URL=postgresql://courtedge:password@localhost:5432/courtedge

# --- Auth ---
SECRET_KEY=                     # python3 -c "import secrets; print(secrets.token_hex(32))"
ADMIN_TASK_KEY=                 # stejný princip jako SECRET_KEY, chrání admin/cron endpointy

# --- api-tennis.com (PRIMÁRNÍ zdroj: historie, nadcházející zápasy, kurzy, settlement) ---
APITENNIS_KEY=

# --- Živé kurzy (the-odds-api.com) — záložní/druhý zdroj kurzů ---
# VLASTNÍ klíč pro CourtEdge, NEsdílet s ApexSignalem (plná izolace appek).
ODDSAPI_KEY=

# --- Telegram (NOVÝ bot přes @BotFather, nesouvisející s ApexSignalem) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- appčin web (odkaz appka přidává k tiketu v Telegramu, není to povinný krok) ---
WEBSITE_URL=https://courtedge-tenis-tipy.netlify.app


# --- Stripe (NOVÝ, samostatný účet) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Appčiny vlastní účty pro cron úlohy ---
DAILY_TICKETS_USER_ID=

# --- Zdroj historických dat pro Elo/market modely (viz README — otevřená otázka) ---
# Lokální cesta nebo URL na CSV soubory ve formátu Sackmann/TML
# (tourney_id, surface, winner_name, loser_name, score, w_ace, l_ace, ...).
HISTORICAL_DATA_SOURCE=
